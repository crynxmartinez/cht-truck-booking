# =============================================================================
# CHT TRUCK BOOKING — environment template (safe to commit)
# =============================================================================
# HOW TO LOAD THESE INTO VERCEL
#
#   Option A (fastest) — Vercel dashboard:
#     Project → Settings → Environment Variables → "Import .env"
#     Drag this file in, or paste the whole block below into the bulk-paste box.
#     Tick Production + Preview + Development.
#
#   Option B — CLI:
#     vercel env pull            # verify what's already there
#     vercel env add <NAME> production
#
# THIS FILE IS GITIGNORED. Never commit it, never paste it into GHL,
# never put it in a browser-visible file. Everything here is server-side only —
# note that none of these are prefixed NEXT_PUBLIC_ except the app URL.
# =============================================================================


# --- Database ----------------------------------------------------------------
# Prisma Postgres, pooled connection. Used by the app at runtime.
DATABASE_URL="<set-in-vercel>"

# Migrations run better over a non-pooled connection. If Prisma gives you a
# direct (non-pooled) URL, put it here and add `directUrl = env("DIRECT_URL")`
# to the datasource block in schema.prisma. If you only ever have the pooled
# URL, set this to the same value — migrations will still work, just slower.
DIRECT_URL="<set-in-vercel>"


# --- GoHighLevel -------------------------------------------------------------
# Private Integration Token. Needs these scopes:
#   contacts.readonly, contacts.write,
#   conversations.readonly, conversations.write,
#   conversations/message.readonly, conversations/message.write,
#   locations/customFields.readonly, locations/customFields.write,
#   opportunities.write   (only if we mirror the pipeline into GHL)
GHL_API_TOKEN="<set-in-vercel>"
GHL_LOCATION_ID="<set-in-vercel>"
GHL_API_BASE="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-07-28"

# Shared secret we generate and put on the GHL inbound webhook URL as ?key=...
# so only GHL can post inbound SMS replies (RESCHEDULE handling) to our API.
GHL_WEBHOOK_KEY="<set-in-vercel>"


# --- Storage (Vercel Blob) ---------------------------------------------------
# DO NOT set BLOB_READ_WRITE_TOKEN by hand. Vercel injects it automatically the
# moment you attach a Blob store: Project → Storage → Create → Blob → Connect.
#
# Total storage the 80%-cleanup rule measures against, in bytes.
#   1 GB  = 1073741824    (Hobby free allowance)
#   100 GB = 107374182400 (Pro)
BLOB_QUOTA_BYTES="1073741824"
BLOB_PURGE_START_PCT="80"     # start deleting once usage crosses this
BLOB_PURGE_TARGET_PCT="70"    # keep deleting until back under this


# --- App secrets (generated for you — unique to this project) ----------------
CRON_SECRET="<set-in-vercel>"
SESSION_SECRET="<set-in-vercel>"
SIGNING_TOKEN_SALT="<set-in-vercel>"


# --- App configuration -------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://cht-truck-booking.vercel.app"

# Comma-separated origins allowed to call the public booking API.
# Add every GHL funnel domain the widget is embedded on, including any custom
# domain. No trailing slashes. The widget will not work until its exact origin
# is listed here.
ALLOWED_ORIGINS="https://cht-truck-booking.vercel.app,https://link.msgsndr.com,https://msgsndr.com"

# Operations
RENTAL_BLOCK_DAYS="3"                        # pickup day + 2 = truck blocked 3 days
MIN_LEAD_DAYS="1"                            # earliest bookable date = tomorrow
MAX_MONTHS_AHEAD="3"                         # calendar horizon
OPS_TIMEZONE="America/Los_Angeles"
PICKUP_ADDRESS="25220 Hancock Ave, Murrieta, CA 92562"
PICKUP_SMS_HOUR="6"                          # 6:00 AM local, pickup day
RETURN_SMS_HOUR="7"                          # 7:00 AM local, return day
UNSIGNED_RELEASE_HOURS="72"                  # auto-release a truck if never signed

# Feature flags — the two upgrades from the plan, off by default per your spec.
# Flip to "true" when you want them; no code change needed.
CHECKLIST_PICKUP_FUEL_GAUGE="false"
CHECKLIST_EXTERIOR_PHOTOS="false"

# Retention, in days after a booking reaches Completed
RETAIN_ID_DOCS_DAYS="30"                     # driver's licence + insurance
RETAIN_CHECKLIST_PHOTOS_DAYS="90"


# --- Seed data (used once, by `npm run seed`) --------------------------------
TRUCK_A_PLATE="764302D"
TRUCK_A_YEAR="2022"
TRUCK_B_PLATE="705921E"
TRUCK_B_YEAR="2021"

# Lockbox codes. These are revealed only in the 6 AM pickup message and on the
# token-gated pickup checklist page. Change them here (or in the CRM) any time.
# 92584 is the code currently hard-coded in your existing checklist form —
# replace it once the system is live, since every past renter still knows it.
TRUCK_A_LOCKBOX="<set-in-vercel>"
TRUCK_B_LOCKBOX="<set-in-vercel>"

# First CRM login. Change the password after you sign in the first time.
ADMIN_EMAIL="el@storagematerials.com"
ADMIN_INITIAL_PASSWORD="<set-in-vercel>"